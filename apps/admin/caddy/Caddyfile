{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting. Hashed build assets (/god-mode/assets/*) are
	# excluded: a single page load fetches ~300 JS chunks, which alone was
	# enough to trip the 300/min limit and 429 a normal user.
	rate_limit {
		zone static {
			match {
				not path /god-mode/assets/*
			}
			key {client_ip}
			events 300
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Build assets have content hashes in their filenames, so browsers can
	# cache them forever instead of revalidating each one on every load.
	# `file` keeps a stale/unknown asset path (served index.html by try_files)
	# from being cached as immutable.
	@hashedAssets {
		path /god-mode/assets/*
		file
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback: the admin build is served from /god-mode
	try_files {path} /god-mode/index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
